      "html": "<label class=\"ds-field\">Описание результата<textarea class=\"ds-textarea\" rows=\"3\">Структура страницы обновлена, ссылки проверены.</textarea></label>",
      "css": ".ds-field{display:block;font-size:11px;color:var(--muted,#acc0c6);line-height:1.65;font-family:Manrope,Segoe UI,sans-serif;}.ds-textarea{display:block;background:#0a1921;border:1px solid #45616b;border-radius:8px;color:var(--ink,#edf5f2);padding:10px;width:100%;max-width:340px;margin-top:6px;font-size:12px;line-height:1.65;min-height:83px;resize:vertical;caret-color:var(--mint,#70e1c2);font-family:Manrope,Segoe UI,sans-serif;}.ds-textarea:focus-visible{outline:3px solid var(--gold,#f0ca7a);outline-offset:3px;}"
