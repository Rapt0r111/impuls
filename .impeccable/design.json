      "html": "<div class=\"ds-segmented\" aria-label=\"Демонстрационная роль\"><button aria-pressed=\"true\">Военнослужащий</button><button aria-pressed=\"false\">Командир</button></div>",
      "css": ".ds-segmented{display:inline-flex;padding:3px;background:#142832;border:1px solid var(--line,#29404a);border-radius:10px}.ds-segmented button{padding:8px 12px;font-size:12px;line-height:1.65;background:transparent;color:var(--muted,#acc0c6);border:0;border-radius:7px;min-height:38px;cursor:pointer;font-family:Manrope,Segoe UI,sans-serif;}.ds-segmented button[aria-pressed=true]{background:var(--mint,#70e1c2);color:var(--bg,#08151c);font-weight:800}.ds-segmented button:focus-visible{outline:3px solid var(--gold,#f0ca7a);outline-offset:3px;}"
