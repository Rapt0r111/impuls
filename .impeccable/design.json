  "narrative": {
    "northStar": "Technological research centre",
    "overview": "The user-selected direction is a technological research centre with dark navy surfaces and turquoise accents. The implemented presentation uses a precise, calm console treatment: compact task rows, outlined controls, line icons and visible numerical progress. Warm gold distinguishes rewards and balances.\n\nA mineral-white reading area gives the detailed proposal a separate, comfortable reading surface. This document records the implemented offline presentation, not an official identity or an approved production design system. It was extracted from `outputs/impuls-presentation.html`, `work/presentation.html` and `work/app.js` after the visual direction was approved.",
    "keyCharacteristics": [
      "Navy surfaces, turquoise actions and warm gold reward values.",
      "Embedded Manrope with compact interface labels and generous reading leading.",
      "Thin dividers and tonal layers rather than raised cards.",
      "A working phone-shaped demonstration beside the presentation narrative.",
      "Readable light documentation, responsive navigation and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Meaningful Accent Rule",
        "body": "Use turquoise for action or progress and gold for reward information; keep text labels alongside state colors.",
