# Copy to apps/app/.env.local for local development.
# On Vercel, DATABASE_URL must be the Supabase transaction-pooler connection string.
DATABASE_URL=postgresql://impuls:change-me@127.0.0.1:5432/impuls
# Base64-encoded Supabase database CA certificate; required on Vercel for TLS verification.
SUPABASE_CA_CERT_B64=
# Direct connection; used only by bun run db:migrate, never by Vercel Functions.
MIGRATION_DATABASE_URL=postgresql://impuls:change-me@127.0.0.1:5432/impuls
TELEGRAM_BOT_TOKEN=
APP_ORIGIN=http://localhost:3000
CSRF_SECRET=
# Only for isolated synthetic development. Does not enable real pilot economics.
SYNTHETIC_ECONOMY_ENABLED=false
# Full one-time reversal of synthetic acceptance awards; independent from acceptance.
SYNTHETIC_LEDGER_CORRECTIONS_ENABLED=false
# Synthetic roster preview only; real ranking visibility awaits P-05.
SYNTHETIC_RANKING_ENABLED=false
# Owner-only synthetic levels and first-result history; no real policy approval.
SYNTHETIC_PROFILE_ENABLED=false
# Exact-scope admin.audit reads synthetic recorded actions only.
SYNTHETIC_AUDIT_ENABLED=false
# Exact-scope admin.notifications reads summary and recent events, independently of the worker flag.
SYNTHETIC_NOTIFICATION_STATUS_ENABLED=false
# Synthetic cosmetic catalog/reservation only; no real service rewards or issuance.
SYNTHETIC_REWARDS_ENABLED=false
# Creates/assigns drafts using explicitly synthetic rules and scope members only.
SYNTHETIC_TASK_MANAGEMENT_ENABLED=false
# Separate worker environment, never copy the application DB credentials here.
# Simulation only: no Bot API request and no outbox 'sent' state.
SYNTHETIC_NOTIFICATIONS_ENABLED=false
# Separate --expire-once/--expire-watch/--expire-status process, impuls_expiry_worker credentials.
# Only saved explicit synthetic deadlines; no default deadline and no Bot API.
SYNTHETIC_RESERVATION_EXPIRY_ENABLED=false
WORKER_DATABASE_URL=
# Both watch modes: 1000..60000 ms, default 5000; pause after batches of at most 20.
WORKER_POLL_INTERVAL_MS=5000
# Speed Insights is included only on Vercel. Set false there to disable it
# (redeploy required); keep disabled locally and before a real-data pilot review.
SPEED_INSIGHTS_ENABLED=false
# Exact-scope read-only inspection of synthetic cosmetic terms and current quota.
SYNTHETIC_ADMIN_CATALOG_ENABLED=false
# Append synthetic terms for existing cosmetic identities; requires separate exact authority.
SYNTHETIC_CATALOG_PUBLICATION_ENABLED=false
# Future synthetic terms; exact admin.catalog.schedule, independent of immediate publication.
SYNTHETIC_CATALOG_SCHEDULING_ENABLED=false
# Append future synthetic quota periods; requires separate exact authority.
SYNTHETIC_QUOTA_PUBLICATION_ENABLED=false

# Create disabled synthetic cosmetics only; separate exact admin.catalog.create.
SYNTHETIC_CATALOG_CREATION_ENABLED=false

SYNTHETIC_CATALOG_CANCELLATION_ENABLED=false
SYNTHETIC_ACCESS_MANAGEMENT_ENABLED=false
