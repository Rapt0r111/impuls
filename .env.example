# Copy to apps/app/.env.local for local development.
# On Vercel, DATABASE_URL must be the Supabase transaction-pooler connection string.
DATABASE_URL=postgresql://impuls:change-me@127.0.0.1:5432/impuls
# Base64-encoded Supabase database CA certificate; required on Vercel for TLS verification.
SUPABASE_CA_CERT_B64=
# Direct connection; used only by bun run db:migrate, never by Vercel Functions.
MIGRATION_DATABASE_URL=postgresql://impuls:change-me@127.0.0.1:5432/impuls
TELEGRAM_BOT_TOKEN=
APP_ORIGIN=http://localhost:3000
CSRF_SECRET=
# Accrual on accepted tasks. Rule version 1 holds test values; real economics need a new rule version (P-04).
ECONOMY_ENABLED=false
# Full one-time reversal of an acceptance award; independent from acceptance.
LEDGER_CORRECTIONS_ENABLED=false
# Monthly ranking. Keep off until ranking visibility is decided (P-05).
RANKING_ENABLED=false
# Own levels and first-result history; level policy is not owner-approved yet.
PROFILE_ENABLED=false
# Exact-scope admin.audit reads recorded actions.
AUDIT_ENABLED=false
# Exact-scope admin.notifications reads summary and recent events, independently of the worker flag.
NOTIFICATION_STATUS_ENABLED=false
# Cosmetic catalog and reservation only; service (non-cosmetic) rewards are not supported.
REWARDS_ENABLED=false
# Creates and assigns task drafts for members of the exact scope.
TASK_MANAGEMENT_ENABLED=false
# Separate worker environment, never copy the application DB credentials here.
# Simulation only: no Bot API request and no outbox 'sent' state.
SYNTHETIC_NOTIFICATIONS_ENABLED=false
# Separate --expire-once/--expire-watch/--expire-status process, impuls_expiry_worker credentials.
# Only saved explicit deadlines; no default deadline.
RESERVATION_EXPIRY_ENABLED=false
WORKER_DATABASE_URL=
# Both watch modes: 1000..60000 ms, default 5000; pause after batches of at most 20.
WORKER_POLL_INTERVAL_MS=5000
# Speed Insights is included only on Vercel. Set false there to disable it
# (redeploy required); keep disabled locally and before a real-data pilot review.
SPEED_INSIGHTS_ENABLED=false
# Exact-scope read-only inspection of cosmetic terms and current quota.
ADMIN_CATALOG_ENABLED=false
RULES_MANAGEMENT_ENABLED=false
# Append terms for existing cosmetic identities; requires separate exact authority.
CATALOG_PUBLICATION_ENABLED=false
# Future terms; exact admin.catalog.schedule, independent of immediate publication.
CATALOG_SCHEDULING_ENABLED=false
# Append future quota periods; requires separate exact authority.
QUOTA_PUBLICATION_ENABLED=false

# Create disabled cosmetics only; separate exact admin.catalog.create.
CATALOG_CREATION_ENABLED=false

CATALOG_CANCELLATION_ENABLED=false
ACCESS_MANAGEMENT_ENABLED=false
